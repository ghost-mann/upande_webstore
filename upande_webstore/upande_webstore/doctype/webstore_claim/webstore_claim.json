   "set_only_once": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "claim_type",
   "fieldtype": "Link",
   "options": "Webstore Claim Type",
   "label": "Claim Type",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Any claim type on record. Webstore Portal Settings decides which of them the customer portal offers; the desk can use any."
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Open\nUnder Review\nApproved\nRejected\nResolved",
   "default": "Open",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "cb_head",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "raised_by",
   "fieldtype": "Link",
   "label": "Raised By",
   "options": "User",
   "set_only_once": 1
  },
  {
   "fieldname": "posting_date",
   "fieldtype": "Datetime",
   "label": "Filed On",
   "read_only": 1
  },
  {
   "fieldname": "against_section",
   "fieldtype": "Section Break",
   "label": "What the claim is about"
  },
  {
   "fieldname": "against_doctype",
   "fieldtype": "Select",
   "label": "Document Type",
   "options": "\nSales Invoice",
   "default": "Sales Invoice"
  },
  {
   "fieldname": "against_document",
   "fieldtype": "Dynamic Link",
   "label": "Document",
   "options": "against_doctype",
   "in_list_view": 1,
   "description": "Must belong to the customer above."
  },
  {
   "fieldname": "related_documents",
   "fieldtype": "Table",
   "label": "Other Related Documents",
   "options": "Webstore Claim Document"
  },
  {
   "fieldname": "lines_section",
   "fieldtype": "Section Break",
   "label": "Claimed Lines",
   "description": "Fetched from the invoice above. A snapshot — later changes to the invoice do not move these rows."
  },
  {
   "fieldname": "lines",
   "fieldtype": "Table",
   "options": "Webstore Claim Line",
   "label": "Lines"
  },
  {
   "fieldname": "proposed_total",
   "fieldtype": "Currency",
   "label": "Proposed Total",
   "read_only": 1,
   "description": "Summed from the claimed lines."
  },
  {
   "fieldname": "approved_total",
   "fieldtype": "Currency",
   "label": "Approved Total",
   "permlevel": 1,
   "description": "Set by finance. No arithmetic ties this to the credit note — a settlement may be paid as a replacement or a discount, and one credit note may cover several claims."
  },
  {
   "fieldname": "approval_note",
   "fieldtype": "Small Text",
   "label": "Approval Note",
   "permlevel": 1
  },
  {
   "fieldname": "detail_section",
   "fieldtype": "Section Break",
   "label": "Detail"
  },
  {
   "fieldname": "description",
   "fieldtype": "Text",
   "label": "What happened",
   "reqd": 1
  },
  {
   "fieldname": "resolution_section",
   "fieldtype": "Section Break",
   "label": "Resolution",
   "description": "Filled in by the sales team. The customer sees both fields on their claim."
  },
  {
   "fieldname": "action",
   "fieldtype": "Link",
   "options": "Webstore Claim Action",
   "label": "Action Taken",
   "description": "What was done about this claim. The credit note, if any, is linked below."
  },
  {
   "fieldname": "credit_note",
   "fieldtype": "Link",
   "label": "Credit Note",
   "options": "Sales Invoice",
   "description": "Raise it from the invoice (Create → Return / Credit Note), then link it here.",
   "link_filters": "[[\"Sales Invoice\",\"is_return\",\"=\",1]]"
  },
  {
   "fieldname": "resolution",
   "fieldtype": "Small Text",
   "label": "Resolution Note"
  },
  {
   "fieldname": "legacy_issue",
   "fieldtype": "Link",
   "label": "Migrated From Issue",
   "options": "Issue",
   "read_only": 1,
   "hidden": 1,
   "description": "Set by the migration from Issue-based claims; makes that patch idempotent."
  }
 ],
